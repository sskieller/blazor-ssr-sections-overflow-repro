@page "/page-c"
@attribute [StreamRendering]

@* Streaming SSR: the FIRST walk emits the loading branch with no PageTitle at all, and the
   section registration lands on the SECOND (streamed) walk, after the await. That is the
   narrowest window between "a section registration happens" and "WriteComponentHtml is
   walking" that a page can create. The spin is randomised so the registration lands at a
   different point of the walk on every request. *@
@if (_loaded)
{
    <PageTitle>Page C</PageTitle>
    <h1>Page C</h1>
    <p>Streamed, PageTitle registered after the await.</p>
}
else
{
    <h1>Page C</h1>
    <p>Loading...</p>
}

@code {
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await PoolWork.SpinAsync(5).ConfigureAwait(false);
        _loaded = true;
    }
}
