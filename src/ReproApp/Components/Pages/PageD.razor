@page "/page-d"

@* The PRE-HOIST shape the issue names: a PageTitle inside a data branch. The first pass
   renders the loading branch, the continuation flips the branch, and the first PageTitle
   component is DISPOSED and a new one REGISTERED for the same HeadOutlet section inside a
   single static-SSR render — two registrations, one disposal, while the walk is in flight.
   The awaited pool hop guarantees the loading branch really renders first. *@
@if (_data is null)
{
    <PageTitle>Loading...</PageTitle>
    <p>Loading...</p>
}
else
{
    <PageTitle>Page D @_data</PageTitle>
    <h1>Page D</h1>
}

@code {
    private string? _data;

    protected override async Task OnInitializedAsync()
    {
        await PoolWork.SpinAsync(2).ConfigureAwait(false);
        _data = "loaded";
    }
}
