@inherits LayoutComponentBase

@* Exactly ONE layout-level PageTitle — dump 2's tree had a single layout PageTitle and still
   raced the walk — but it is registered from a CONTINUATION, not from the first synchronous
   pass. The layout awaits before it renders, so its section registration lands while the
   renderer is resolving pending tasks, which is where the crash stack enters the walk
   (WaitForResultReady / WaitForNonStreamingPendingTasks). *@
@if (_ready)
{
    <PageTitle>Repro</PageTitle>
}

<main>
    @Body
</main>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await PoolWork.SpinAsync(2).ConfigureAwait(false);
        _ready = true;
    }
}
